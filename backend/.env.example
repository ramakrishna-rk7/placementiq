# Backend environment variables for PlacementIQ
# Copy to .env and fill in values

# Database (SQLite for local dev, PostgreSQL on Render)
DATABASE_URL=sqlite:///./placementiq.db

# Auth
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Groq (LLM)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant (vector DB)
# Local: QDRANT_URL=http://localhost:6333
# Cloud: QDRANT_URL=https://xxx.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
